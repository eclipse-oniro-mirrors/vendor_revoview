import("//build/ohos.gni")

ohos_prebuilt_etc("compatibility_config_meta") {
    source = "config_meta.json"
    relative_install_dir = "multDeviceCenter"
    part_name = "product_wukong100"
}

ohos_prebuilt_etc("compatibility_camera_applist") {
    source = "camera_applist.json"
    relative_install_dir = "multDeviceCenter"
    part_name = "product_wukong100"
}

ohos_prebuilt_etc("compatibility_keyboardmouse_applist") {
    source = "keyboardmouse_applist.json"
    relative_install_dir = "multDeviceCenter"
    part_name = "product_wukong100"
}

group("multdevice_config") {
    deps = [
        ":compatibility_config_meta",
        ":compatibility_camera_applist",
        ":compatibility_keyboardmouse_applist",
    ]
}
